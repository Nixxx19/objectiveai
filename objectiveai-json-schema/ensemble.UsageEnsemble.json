{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ensemble.UsageEnsemble",
  "description": "Usage statistics for an Ensemble.",
  "type": "object",
  "properties": {
    "requests": {
      "description": "Total number of requests made with this Ensemble.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "completion_tokens": {
      "description": "Total completion tokens generated across all agents.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "prompt_tokens": {
      "description": "Total prompt tokens processed across all agents.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "total_cost": {
      "description": "Total cost incurred.",
      "type": "number",
      "format": "double"
    }
  },
  "required": [
    "requests",
    "completion_tokens",
    "prompt_tokens",
    "total_cost"
  ]
}
