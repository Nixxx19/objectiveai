{
  "title": "agent.completions.request.ResponseFormat",
  "description": "The format of the model's response.",
  "anyOf": [
    {
      "title": "Text",
      "description": "Plain text response (default).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text"
          ]
        }
      }
    },
    {
      "title": "JsonObject",
      "description": "Response must be valid JSON.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "json_object"
          ]
        }
      }
    },
    {
      "title": "JsonSchema",
      "description": "Response must conform to a JSON schema.",
      "type": "object",
      "properties": {
        "schema": {
          "description": "The JSON Schema definition.",
          "type": "object",
          "additionalProperties": true
        },
        "type": {
          "type": "string",
          "enum": [
            "json_schema"
          ]
        }
      }
    },
    {
      "title": "Grammar",
      "description": "Response must conform to a grammar.",
      "type": "object",
      "properties": {
        "grammar": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "grammar"
          ]
        }
      }
    },
    {
      "title": "Python",
      "description": "Response must be valid Python code.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "python"
          ]
        }
      }
    },
    {
      "title": "ToolCall",
      "description": "The final assistant message will contain this tool call",
      "type": "object",
      "properties": {
        "description": {
          "description": "A description of the tool.",
          "type": "string"
        },
        "name": {
          "description": "The name of the tool.",
          "type": "string"
        },
        "required": {
          "description": "Whether the tool MUST be called.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "omitempty": true
        },
        "schema": {
          "description": "The JSON Schema definition.",
          "type": "object",
          "additionalProperties": true
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call"
          ]
        }
      }
    }
  ]
}
