{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent.completions.request.ResponseFormat",
  "description": "The format of the model's response.",
  "oneOf": [
    {
      "description": "Plain text response (default).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "Response must be valid JSON.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "json_object"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "Response must conform to a JSON schema.",
      "type": "object",
      "properties": {
        "schema": {
          "description": "The JSON Schema definition.",
          "type": "object",
          "additionalProperties": true
        },
        "type": {
          "type": "string",
          "const": "json_schema"
        }
      },
      "required": [
        "type",
        "schema"
      ]
    },
    {
      "description": "Response must conform to a grammar.",
      "type": "object",
      "properties": {
        "grammar": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "grammar"
        }
      },
      "required": [
        "type",
        "grammar"
      ]
    },
    {
      "description": "Response must be valid Python code.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "python"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "The final assistant message will contain this tool call",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name of the tool.",
          "type": "string"
        },
        "description": {
          "description": "A description of the tool.",
          "type": "string"
        },
        "schema": {
          "description": "The JSON Schema definition.",
          "type": "object",
          "additionalProperties": true
        },
        "required": {
          "description": "Whether the tool MUST be called.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "tool_call"
        }
      },
      "required": [
        "type",
        "name",
        "description",
        "schema"
      ]
    }
  ]
}
