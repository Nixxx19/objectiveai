{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functions.profiles.computations.response.unary.FunctionProfileComputation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "functions.profiles.computations.response.unary.FunctionExecution"
      }
    },
    "executions_errors": {
      "type": "boolean"
    },
    "profile": {
      "$ref": "functions.InlineTasksProfile"
    },
    "fitting_stats": {
      "$ref": "functions.profiles.computations.response.FittingStats"
    },
    "retry_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "function": {
      "type": [
        "string",
        "null"
      ]
    },
    "object": {
      "$ref": "functions.profiles.computations.response.unary.Object"
    },
    "usage": {
      "$ref": "agent.completions.response.Usage"
    }
  },
  "required": [
    "id",
    "executions",
    "executions_errors",
    "profile",
    "fitting_stats",
    "created",
    "object",
    "usage"
  ]
}
