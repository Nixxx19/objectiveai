{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier of the chat completion."
    },
    "upstream_id": {
      "type": "string",
      "description": "The unique identifier of the upstream chat completion."
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "object",
            "properties": {
              "content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The content of the message."
              },
              "refusal": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The refusal message, if any."
              },
              "role": {
                "enum": [
                  "assistant"
                ],
                "description": "The role of the message author."
              },
              "tool_calls": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "function"
                            },
                            "id": {
                              "type": "string",
                              "description": "The unique identifier of the function tool."
                            },
                            "function": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "description": "The name of the function."
                                },
                                "arguments": {
                                  "type": "string",
                                  "description": "The arguments passed to the function."
                                }
                              },
                              "required": [
                                "name",
                                "arguments"
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "id"
                          ],
                          "description": "A function tool call made by the assistant."
                        }
                      ],
                      "description": "A tool call made by the assistant."
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The tool calls made by the assistant, if any."
              },
              "reasoning": {
                "type": "string",
                "description": "The reasoning provided by the assistant, if any."
              },
              "images": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "image_url"
                        },
                        "image_url": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "description": "The Base64 URL of the generated image."
                            }
                          },
                          "required": [
                            "url"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "image_url"
                      ]
                    }
                  ],
                  "description": "An image generated by the model."
                },
                "description": "The images generated by the assistant, if any."
              }
            },
            "required": [
              "content",
              "refusal",
              "role",
              "tool_calls"
            ],
            "description": "A message generated by the assistant."
          },
          "finish_reason": {
            "enum": [
              "stop",
              "length",
              "tool_calls",
              "content_filter",
              "error"
            ],
            "description": "The reason why the assistant ceased to generate further tokens."
          },
          "index": {
            "type": "integer",
            "description": "The index of the choice in the list of choices."
          },
          "logprobs": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "content": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "token": {
                              "type": "string",
                              "description": "The token string which was selected by the sampler."
                            },
                            "bytes": {
                              "anyOf": [
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "integer"
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "The byte representation of the token which was selected by the sampler."
                            },
                            "logprob": {
                              "type": "number",
                              "description": "The log probability of the token which was selected by the sampler."
                            },
                            "top_logprobs": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "token": {
                                    "type": "string",
                                    "description": "The token string."
                                  },
                                  "bytes": {
                                    "anyOf": [
                                      {
                                        "type": "array",
                                        "items": {
                                          "type": "integer"
                                        }
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "description": "The byte representation of the token."
                                  },
                                  "logprob": {
                                    "anyOf": [
                                      {
                                        "type": "number"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "description": "The log probability of the token."
                                  }
                                },
                                "required": [
                                  "token"
                                ],
                                "description": "The log probability of a token in the list of top tokens."
                              },
                              "description": "The log probabilities of the top tokens for this position."
                            }
                          },
                          "required": [
                            "token",
                            "logprob",
                            "top_logprobs"
                          ],
                          "description": "The token which was selected by the sampler for this position as well as the logprobabilities of the top options."
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The log probabilities of the tokens in the content."
                  },
                  "refusal": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "token": {
                              "type": "string",
                              "description": "The token string which was selected by the sampler."
                            },
                            "bytes": {
                              "anyOf": [
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "integer"
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "The byte representation of the token which was selected by the sampler."
                            },
                            "logprob": {
                              "type": "number",
                              "description": "The log probability of the token which was selected by the sampler."
                            },
                            "top_logprobs": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "token": {
                                    "type": "string",
                                    "description": "The token string."
                                  },
                                  "bytes": {
                                    "anyOf": [
                                      {
                                        "type": "array",
                                        "items": {
                                          "type": "integer"
                                        }
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "description": "The byte representation of the token."
                                  },
                                  "logprob": {
                                    "anyOf": [
                                      {
                                        "type": "number"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "description": "The log probability of the token."
                                  }
                                },
                                "required": [
                                  "token"
                                ],
                                "description": "The log probability of a token in the list of top tokens."
                              },
                              "description": "The log probabilities of the top tokens for this position."
                            }
                          },
                          "required": [
                            "token",
                            "logprob",
                            "top_logprobs"
                          ],
                          "description": "The token which was selected by the sampler for this position as well as the logprobabilities of the top options."
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The log probabilities of the tokens in the refusal."
                  }
                },
                "description": "The log probabilities of the tokens generated by the model."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "message",
          "finish_reason",
          "index",
          "logprobs"
        ],
        "description": "A choice in a unary chat completion response."
      },
      "description": "The list of choices in this chat completion."
    },
    "created": {
      "type": "integer",
      "description": "The Unix timestamp (in seconds) when the chat completion was created."
    },
    "model": {
      "type": "string",
      "description": "The unique identifier of the Ensemble LLM used for this chat completion."
    },
    "upstream_model": {
      "type": "string",
      "description": "The upstream model used for this chat completion."
    },
    "object": {
      "const": "chat.completion"
    },
    "service_tier": {
      "type": "string"
    },
    "system_fingerprint": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "completion_tokens": {
          "type": "integer",
          "description": "The number of tokens generated in the completion."
        },
        "prompt_tokens": {
          "type": "integer",
          "description": "The number of tokens in the prompt."
        },
        "total_tokens": {
          "type": "integer",
          "description": "The total number of tokens used in the prompt or generated in the completion."
        },
        "completion_tokens_details": {
          "type": "object",
          "properties": {
            "accepted_prediction_tokens": {
              "type": "integer",
              "description": "The number of accepted prediction tokens in the completion."
            },
            "audio_tokens": {
              "type": "integer",
              "description": "The number of generated audio tokens in the completion."
            },
            "reasoning_tokens": {
              "type": "integer",
              "description": "The number of generated reasoning tokens in the completion."
            },
            "rejected_prediction_tokens": {
              "type": "integer",
              "description": "The number of rejected prediction tokens in the completion."
            }
          },
          "description": "Detailed breakdown of generated completion tokens."
        },
        "prompt_tokens_details": {
          "type": "object",
          "properties": {
            "audio_tokens": {
              "type": "integer",
              "description": "The number of audio tokens in the prompt."
            },
            "cached_tokens": {
              "type": "integer",
              "description": "The number of cached tokens in the prompt."
            },
            "cache_write_tokens": {
              "type": "integer",
              "description": "The number of prompt tokens written to cache."
            },
            "video_tokens": {
              "type": "integer",
              "description": "The number of video tokens in the prompt."
            }
          },
          "description": "Detailed breakdown of prompt tokens."
        },
        "cost": {
          "type": "number",
          "description": "The cost in credits incurred for this completion."
        },
        "cost_details": {
          "type": "object",
          "properties": {
            "upstream_inference_cost": {
              "type": "number",
              "description": "The cost incurred upstream."
            },
            "upstream_upstream_inference_cost": {
              "type": "number",
              "description": "The cost incurred by upstream's upstream."
            }
          },
          "description": "Detailed breakdown of upstream costs incurred."
        },
        "total_cost": {
          "type": "number",
          "description": "The total cost in credits incurred including upstream costs."
        },
        "cost_multiplier": {
          "type": "number",
          "description": "The cost multiplier applied to upstream costs for computing ObjectiveAI costs."
        },
        "is_byok": {
          "type": "boolean",
          "description": "Whether the completion used a BYOK (Bring Your Own Key) API Key."
        }
      },
      "required": [
        "completion_tokens",
        "prompt_tokens",
        "total_tokens",
        "cost",
        "total_cost",
        "cost_multiplier",
        "is_byok"
      ],
      "description": "Token and cost usage statistics for the completion."
    },
    "upstream": {
      "$ref": "Upstream",
      "description": "The upstream provider that served the request."
    },
    "provider": {
      "type": "string",
      "description": "The provider used for this chat completion."
    },
    "index": {
      "type": "integer",
      "description": "The index of the completion amongst all chat completions."
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "description": "The status code of the error."
        },
        "message": {
          "$ref": "JsonValue",
          "description": "The message or details of the error."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "description": "An error encountered during the generation of this chat completion."
    }
  },
  "required": [
    "id",
    "upstream_id",
    "choices",
    "created",
    "model",
    "upstream_model",
    "object",
    "usage",
    "upstream",
    "index"
  ],
  "description": "A chat completion generated in the pursuit of a vector completion."
}
