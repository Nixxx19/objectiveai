{
  "type": "object",
  "properties": {
    "type": {
      "const": "json_schema"
    },
    "json_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the JSON schema."
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The description of the JSON schema."
        },
        "schema": {
          "$ref": "JsonValue",
          "description": "The JSON schema definition."
        },
        "strict": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether to enforce strict adherence to the JSON schema."
        }
      },
      "required": [
        "name"
      ],
      "description": "A JSON schema definition for constraining model output."
    }
  },
  "required": [
    "type",
    "json_schema"
  ],
  "description": "The response will conform to the provided JSON schema."
}
