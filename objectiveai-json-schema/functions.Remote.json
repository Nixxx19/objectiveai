{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functions.Remote",
  "description": "The remote source where a function or profile is hosted.",
  "oneOf": [
    {
      "description": "GitHub repository.",
      "type": "string",
      "const": "github"
    },
    {
      "description": "Local filesystem.",
      "type": "string",
      "const": "filesystem"
    },
    {
      "description": "Mock (for testing).",
      "type": "string",
      "const": "mock"
    }
  ]
}
