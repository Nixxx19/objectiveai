        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "user"
        }
      },
      "$ref": "AgentCompletionsMessageUserMessageExpression",
      "required": [
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
