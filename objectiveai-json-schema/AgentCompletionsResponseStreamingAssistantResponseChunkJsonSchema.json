{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletionsResponseStreamingAssistantResponseChunk",
  "description": "A chunk of a streaming agent completion response.\n\nMultiple chunks are received via Server-Sent Events and can be\naccumulated into a complete [`AgentCompletion`](response::unary::AgentCompletion)\nusing the [`push`](Self::push) method.",
  "type": "object",
  "properties": {
    "role": {
      "$ref": "AgentCompletionsResponseAssistantRole"
    },
    "index": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "created": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "upstream_id": {
      "type": "string"
    },
    "reasoning": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_calls": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "AgentCompletionsMessageAssistantToolCallDelta"
      }
    },
    "content": {
      "anyOf": [
        {
          "$ref": "AgentCompletionsMessageRichContent"
        },
        {
          "type": "null"
        }
      ]
    },
    "refusal": {
      "type": [
        "string",
        "null"
      ]
    },
    "finish_reason": {
      "anyOf": [
        {
          "$ref": "AgentCompletionsResponseFinishReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "logprobs": {
      "anyOf": [
        {
          "$ref": "AgentCompletionsResponseLogprobs"
        },
        {
          "type": "null"
        }
      ]
    },
    "service_tier": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "description": "Upstream usage for this assistant response (set by upstream clients).",
      "anyOf": [
        {
          "$ref": "AgentCompletionsResponseUpstreamUsage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "role",
    "index",
    "created",
    "agent",
    "model",
    "upstream_id"
  ]
}
