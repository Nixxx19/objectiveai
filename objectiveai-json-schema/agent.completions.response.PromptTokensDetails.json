{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent.completions.response.PromptTokensDetails",
  "description": "Detailed breakdown of prompt token usage.",
  "type": "object",
  "properties": {
    "audio_tokens": {
      "description": "Audio input tokens.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "cached_tokens": {
      "description": "Tokens served from cache.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "cache_write_tokens": {
      "description": "Tokens written to cache.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "video_tokens": {
      "description": "Video input tokens.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  }
}
