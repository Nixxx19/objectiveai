{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functions.expression.TaskOutputRef",
  "description": "Borrowed task output variants.",
  "anyOf": [
    {
      "description": "A single scalar score.",
      "type": "number",
      "format": "double"
    },
    {
      "description": "A vector of scores.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      }
    },
    {
      "description": "Multiple vectors of scores (from mapped tasks).",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "format": "double"
        }
      }
    },
    {
      "description": "An error occurred during execution."
    }
  ]
}
