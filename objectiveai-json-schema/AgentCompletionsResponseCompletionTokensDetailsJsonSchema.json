{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletionsResponseCompletionTokensDetails",
  "description": "Detailed breakdown of completion token usage.",
  "type": "object",
  "properties": {
    "accepted_prediction_tokens": {
      "description": "Tokens from accepted predictions (speculative decoding).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "audio_tokens": {
      "description": "Audio output tokens.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "reasoning_tokens": {
      "description": "Tokens used for reasoning/thinking.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "rejected_prediction_tokens": {
      "description": "Tokens from rejected predictions (speculative decoding).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  }
}
