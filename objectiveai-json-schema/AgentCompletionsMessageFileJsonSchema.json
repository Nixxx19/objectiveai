{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletionsMessageFile",
  "description": "A file attachment for multimodal input.",
  "type": "object",
  "properties": {
    "file_data": {
      "description": "Base64-encoded file data.",
      "type": [
        "string",
        "null"
      ]
    },
    "file_id": {
      "description": "The ID of a previously uploaded file.",
      "type": [
        "string",
        "null"
      ]
    },
    "filename": {
      "description": "The filename for display purposes.",
      "type": [
        "string",
        "null"
      ]
    },
    "file_url": {
      "description": "A URL to fetch the file from.",
      "type": [
        "string",
        "null"
      ]
    }
  }
}
