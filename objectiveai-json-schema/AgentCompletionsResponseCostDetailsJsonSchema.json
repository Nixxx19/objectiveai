{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletionsResponseCostDetails",
  "description": "Detailed cost breakdown.",
  "type": "object",
  "properties": {
    "upstream_inference_cost": {
      "description": "Cost charged by the immediate upstream (e.g., OpenRouter).",
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$"
    },
    "upstream_upstream_inference_cost": {
      "description": "Cost charged by the upstream's upstream (e.g., the actual model provider).",
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$"
    }
  },
  "required": [
    "upstream_inference_cost",
    "upstream_upstream_inference_cost"
  ]
}
