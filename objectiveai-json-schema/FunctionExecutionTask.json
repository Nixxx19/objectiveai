{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier of the function execution."
    },
    "tasks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "description": "A function execution task."
          },
          {
            "$ref": "VectorCompletionTask",
            "description": "A vector completion task."
          }
        ],
        "description": "A task execution."
      },
      "description": "The tasks executed as part of the function execution."
    },
    "tasks_errors": {
      "type": "boolean",
      "description": "When true, indicates that one or more tasks encountered errors during execution."
    },
    "reasoning": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The unique identifier of the chat completion."
            },
            "upstream_id": {
              "type": "string",
              "description": "The unique identifier of the upstream chat completion."
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "object",
                    "properties": {
                      "content": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "The content of the message."
                      },
                      "refusal": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "The refusal message, if any."
                      },
                      "role": {
                        "enum": [
                          "assistant"
                        ],
                        "description": "The role of the message author."
                      },
                      "tool_calls": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "const": "function"
                                    },
                                    "id": {
                                      "type": "string",
                                      "description": "The unique identifier of the function tool."
                                    },
                                    "function": {
                                      "type": "object",
                                      "properties": {
                                        "name": {
                                          "type": "string",
                                          "description": "The name of the function."
                                        },
                                        "arguments": {
                                          "type": "string",
                                          "description": "The arguments passed to the function."
                                        }
                                      },
                                      "required": [
                                        "name",
                                        "arguments"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "id"
                                  ],
                                  "description": "A function tool call made by the assistant."
                                }
                              ],
                              "description": "A tool call made by the assistant."
                            }
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "The tool calls made by the assistant, if any."
                      },
                      "reasoning": {
                        "type": "string",
                        "description": "The reasoning provided by the assistant, if any."
                      },
                      "images": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "const": "image_url"
                                },
                                "image_url": {
                                  "type": "object",
                                  "properties": {
                                    "url": {
                                      "type": "string",
                                      "description": "The Base64 URL of the generated image."
                                    }
                                  },
                                  "required": [
                                    "url"
                                  ]
                                }
                              },
                              "required": [
                                "type",
                                "image_url"
                              ]
                            }
                          ],
                          "description": "An image generated by the model."
                        },
                        "description": "The images generated by the assistant, if any."
                      }
                    },
                    "required": [
                      "content",
                      "refusal",
                      "role",
                      "tool_calls"
                    ],
                    "description": "A message generated by the assistant."
                  },
                  "finish_reason": {
                    "enum": [
                      "stop",
                      "length",
                      "tool_calls",
                      "content_filter",
                      "error"
                    ],
                    "description": "The reason why the assistant ceased to generate further tokens."
                  },
                  "index": {
                    "type": "integer",
                    "description": "The index of the choice in the list of choices."
                  },
                  "logprobs": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "content": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "token": {
                                      "type": "string",
                                      "description": "The token string which was selected by the sampler."
                                    },
                                    "bytes": {
                                      "anyOf": [
                                        {
                                          "type": "array",
                                          "items": {
                                            "type": "integer"
                                          }
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "The byte representation of the token which was selected by the sampler."
                                    },
                                    "logprob": {
                                      "type": "number",
                                      "description": "The log probability of the token which was selected by the sampler."
                                    },
                                    "top_logprobs": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "token": {
                                            "type": "string",
                                            "description": "The token string."
                                          },
                                          "bytes": {
                                            "anyOf": [
                                              {
                                                "type": "array",
                                                "items": {
                                                  "type": "integer"
                                                }
                                              },
                                              {
                                                "type": "null"
                                              }
                                            ],
                                            "description": "The byte representation of the token."
                                          },
                                          "logprob": {
                                            "anyOf": [
                                              {
                                                "type": "number"
                                              },
                                              {
                                                "type": "null"
                                              }
                                            ],
                                            "description": "The log probability of the token."
                                          }
                                        },
                                        "required": [
                                          "token"
                                        ],
                                        "description": "The log probability of a token in the list of top tokens."
                                      },
                                      "description": "The log probabilities of the top tokens for this position."
                                    }
                                  },
                                  "required": [
                                    "token",
                                    "logprob",
                                    "top_logprobs"
                                  ],
                                  "description": "The token which was selected by the sampler for this position as well as the logprobabilities of the top options."
                                }
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "The log probabilities of the tokens in the content."
                          },
                          "refusal": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "token": {
                                      "type": "string",
                                      "description": "The token string which was selected by the sampler."
                                    },
                                    "bytes": {
                                      "anyOf": [
                                        {
                                          "type": "array",
                                          "items": {
                                            "type": "integer"
                                          }
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "The byte representation of the token which was selected by the sampler."
                                    },
                                    "logprob": {
                                      "type": "number",
                                      "description": "The log probability of the token which was selected by the sampler."
                                    },
                                    "top_logprobs": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "token": {
                                            "type": "string",
                                            "description": "The token string."
                                          },
                                          "bytes": {
                                            "anyOf": [
                                              {
                                                "type": "array",
                                                "items": {
                                                  "type": "integer"
                                                }
                                              },
                                              {
                                                "type": "null"
                                              }
                                            ],
                                            "description": "The byte representation of the token."
                                          },
                                          "logprob": {
                                            "anyOf": [
                                              {
                                                "type": "number"
                                              },
                                              {
                                                "type": "null"
                                              }
                                            ],
                                            "description": "The log probability of the token."
                                          }
                                        },
                                        "required": [
                                          "token"
                                        ],
                                        "description": "The log probability of a token in the list of top tokens."
                                      },
                                      "description": "The log probabilities of the top tokens for this position."
                                    }
                                  },
                                  "required": [
                                    "token",
                                    "logprob",
                                    "top_logprobs"
                                  ],
                                  "description": "The token which was selected by the sampler for this position as well as the logprobabilities of the top options."
                                }
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "The log probabilities of the tokens in the refusal."
                          }
                        },
                        "description": "The log probabilities of the tokens generated by the model."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "message",
                  "finish_reason",
                  "index",
                  "logprobs"
                ],
                "description": "A choice in a unary chat completion response."
              },
              "description": "The list of choices in this chat completion."
            },
            "created": {
              "type": "integer",
              "description": "The Unix timestamp (in seconds) when the chat completion was created."
            },
            "model": {
              "type": "string",
              "description": "The unique identifier of the Ensemble LLM used for this chat completion."
            },
            "upstream_model": {
              "type": "string",
              "description": "The upstream model used for this chat completion."
            },
            "object": {
              "const": "chat.completion"
            },
            "service_tier": {
              "type": "string"
            },
            "system_fingerprint": {
              "type": "string"
            },
            "usage": {
              "$ref": "ChatCompletionUsage",
              "description": "Token and cost usage statistics for the completion."
            },
            "upstream": {
              "$ref": "Upstream",
              "description": "The upstream provider that served the request."
            },
            "provider": {
              "type": "string",
              "description": "The provider used for this chat completion."
            },
            "error": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "The status code of the error."
                    },
                    "message": {
                      "$ref": "JsonValue",
                      "description": "The message or details of the error."
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "description": "An error returned by the ObjectiveAI API."
                },
                {
                  "type": "null"
                }
              ],
              "description": "When non-null, indicates that an error occurred during the chat completion."
            }
          },
          "required": [
            "id",
            "upstream_id",
            "choices",
            "created",
            "model",
            "upstream_model",
            "object",
            "usage",
            "upstream",
            "error"
          ],
          "description": "A reasoning summary generation."
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "number",
          "description": "The scalar output of the function execution."
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The vector output of the function execution."
        },
        {
          "$ref": "JsonValue",
          "description": "The erroneous output of the function execution."
        }
      ],
      "description": "The output of the function execution."
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "description": "The status code of the error."
            },
            "message": {
              "$ref": "JsonValue",
              "description": "The message or details of the error."
            }
          },
          "required": [
            "code",
            "message"
          ],
          "description": "An error returned by the ObjectiveAI API."
        },
        {
          "type": "null"
        }
      ],
      "description": "When non-null, indicates that an error occurred during the function execution."
    },
    "retry_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A token which may be used to retry the function execution."
    },
    "created": {
      "type": "integer",
      "description": "The UNIX timestamp (in seconds) when the function execution chunk was created."
    },
    "function": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The unique identifier of the function being executed."
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The unique identifier of the profile being used."
    },
    "object": {
      "enum": [
        "scalar.function.execution",
        "vector.function.execution"
      ],
      "description": "The object type."
    },
    "usage": {
      "$ref": "VectorCompletionUsage",
      "description": "Token and cost usage statistics for the completion."
    },
    "index": {
      "type": "integer",
      "description": "The index of the task in the sequence of tasks."
    },
    "task_index": {
      "type": "integer",
      "description": "The index of the task amongst all mapped and non-skipped compiled tasks. Used internally."
    },
    "task_path": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "The path of this task which may be used to navigate which nested task this is amongst the root functions tasks and sub-tasks."
    },
    "swiss_round": {
      "type": "number",
      "description": "The Swiss system round number (1-indexed)."
    },
    "swiss_pool_index": {
      "type": "number",
      "description": "The index of this task within its Swiss system pool."
    }
  },
  "required": [
    "id",
    "tasks",
    "tasks_errors",
    "reasoning",
    "output",
    "error",
    "retry_token",
    "created",
    "function",
    "profile",
    "object",
    "usage",
    "index",
    "task_index",
    "task_path"
  ],
  "description": "A function execution task."
}
