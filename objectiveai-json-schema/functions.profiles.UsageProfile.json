{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functions.profiles.UsageProfile",
  "description": "Usage statistics for a profile.",
  "type": "object",
  "properties": {
    "requests": {
      "description": "Total number of requests made with this profile.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "completion_tokens": {
      "description": "Total completion tokens used.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "prompt_tokens": {
      "description": "Total prompt tokens used.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "total_cost": {
      "description": "Total cost incurred.",
      "type": "number",
      "format": "double"
    }
  },
  "required": [
    "requests",
    "completion_tokens",
    "prompt_tokens",
    "total_cost"
  ]
}
