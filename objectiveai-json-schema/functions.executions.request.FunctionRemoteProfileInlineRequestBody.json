{
  "title": "functions.executions.request.FunctionRemoteProfileInlineRequestBody",
  "description": "Request body for remote Function with inline Profile.",
  "type": "object",
  "properties": {
    "from_cache": {
      "description": "If true, uses cached votes when available.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "input": {
      "description": "The input data to pass to the Function.",
      "$ref": "functions.expression.InputValue"
    },
    "mcp_server_authorization": {
      "description": "Map from MCP server URL to authorization header value.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "description": "The inline Profile definition.",
      "$ref": "functions.InlineProfile"
    },
    "provider": {
      "description": "Provider routing preferences.",
      "anyOf": [
        {
          "$ref": "agent.completions.request.Provider"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning": {
      "description": "Reasoning summary configuration.",
      "anyOf": [
        {
          "$ref": "functions.executions.request.Reasoning"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_token": {
      "description": "If present, reuses votes from a previous execution with this token.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "description": "Random seed for deterministic results.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "strategy": {
      "description": "Execution strategy.\nDefaults to `Default` strategy if not specified.",
      "anyOf": [
        {
          "$ref": "functions.executions.request.Strategy"
        },
        {
          "type": "null"
        }
      ]
    },
    "stream": {
      "description": "Whether to stream the response.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
