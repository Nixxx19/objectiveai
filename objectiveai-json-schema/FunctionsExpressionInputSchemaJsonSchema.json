{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FunctionsExpressionInputSchema",
  "description": "Schema for validating Function input.\n\nDefines the expected structure and constraints for input data.\nUsed by remote Functions to document and validate their inputs.",
  "oneOf": [
    {
      "description": "An object with named properties.",
      "type": "object",
      "properties": {
        "Object": {
          "$ref": "FunctionsExpressionObjectInputSchema"
        }
      },
      "required": [
        "Object"
      ],
      "additionalProperties": false
    },
    {
      "description": "An array of items.",
      "type": "object",
      "properties": {
        "Array": {
          "$ref": "FunctionsExpressionArrayInputSchema"
        }
      },
      "required": [
        "Array"
      ],
      "additionalProperties": false
    },
    {
      "description": "A string value.",
      "type": "object",
      "properties": {
        "String": {
          "$ref": "FunctionsExpressionStringInputSchema"
        }
      },
      "required": [
        "String"
      ],
      "additionalProperties": false
    },
    {
      "description": "An integer value.",
      "type": "object",
      "properties": {
        "Integer": {
          "$ref": "FunctionsExpressionIntegerInputSchema"
        }
      },
      "required": [
        "Integer"
      ],
      "additionalProperties": false
    },
    {
      "description": "A floating-point number.",
      "type": "object",
      "properties": {
        "Number": {
          "$ref": "FunctionsExpressionNumberInputSchema"
        }
      },
      "required": [
        "Number"
      ],
      "additionalProperties": false
    },
    {
      "description": "A boolean value.",
      "type": "object",
      "properties": {
        "Boolean": {
          "$ref": "FunctionsExpressionBooleanInputSchema"
        }
      },
      "required": [
        "Boolean"
      ],
      "additionalProperties": false
    },
    {
      "description": "An image (URL or base64).",
      "type": "object",
      "properties": {
        "Image": {
          "$ref": "FunctionsExpressionImageInputSchema"
        }
      },
      "required": [
        "Image"
      ],
      "additionalProperties": false
    },
    {
      "description": "Audio content.",
      "type": "object",
      "properties": {
        "Audio": {
          "$ref": "FunctionsExpressionAudioInputSchema"
        }
      },
      "required": [
        "Audio"
      ],
      "additionalProperties": false
    },
    {
      "description": "Video content.",
      "type": "object",
      "properties": {
        "Video": {
          "$ref": "FunctionsExpressionVideoInputSchema"
        }
      },
      "required": [
        "Video"
      ],
      "additionalProperties": false
    },
    {
      "description": "A file.",
      "type": "object",
      "properties": {
        "File": {
          "$ref": "FunctionsExpressionFileInputSchema"
        }
      },
      "required": [
        "File"
      ],
      "additionalProperties": false
    },
    {
      "description": "A union of schemas - input must match at least one.",
      "type": "object",
      "properties": {
        "AnyOf": {
          "$ref": "FunctionsExpressionAnyOfInputSchema"
        }
      },
      "required": [
        "AnyOf"
      ],
      "additionalProperties": false
    }
  ]
}
