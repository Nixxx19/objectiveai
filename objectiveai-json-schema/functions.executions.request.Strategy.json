{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functions.executions.request.Strategy",
  "oneOf": [
    {
      "description": "Scalar or Vector",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "default"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "Vector",
      "type": "object",
      "properties": {
        "pool": {
          "description": "How many vector responses for each execution",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "rounds": {
          "description": "How many sequential rounds of comparison",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "swiss_system"
        }
      },
      "required": [
        "type"
      ]
    }
  ]
}
