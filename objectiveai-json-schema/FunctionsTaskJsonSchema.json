{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FunctionsTask",
  "description": "A compiled task ready for execution.\n\nProduced by compiling a [`TaskExpression`] against input data. All\nexpressions have been resolved to concrete values.",
  "oneOf": [
    {
      "description": "Calls a scalar function (produces a single score).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "scalar.function"
        }
      },
      "$ref": "FunctionsScalarFunctionTask",
      "required": [
        "type"
      ]
    },
    {
      "description": "Calls a vector function (produces a vector of scores).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "vector.function"
        }
      },
      "$ref": "FunctionsVectorFunctionTask",
      "required": [
        "type"
      ]
    },
    {
      "description": "Runs a vector completion.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "vector.completion"
        }
      },
      "$ref": "FunctionsVectorCompletionTask",
      "required": [
        "type"
      ]
    },
    {
      "description": "Placeholder scalar function (always outputs 0.5).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "placeholder.scalar.function"
        }
      },
      "$ref": "FunctionsPlaceholderScalarFunctionTask",
      "required": [
        "type"
      ]
    },
    {
      "description": "Placeholder vector function (always outputs equalized vector).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "placeholder.vector.function"
        }
      },
      "$ref": "FunctionsPlaceholderVectorFunctionTask",
      "required": [
        "type"
      ]
    }
  ]
}
