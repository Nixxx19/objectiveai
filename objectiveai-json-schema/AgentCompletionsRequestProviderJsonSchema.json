{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletionsRequestProvider",
  "description": "Provider routing and selection preferences.",
  "type": "object",
  "properties": {
    "data_collection": {
      "description": "Whether to allow providers to collect data.",
      "anyOf": [
        {
          "$ref": "AgentCompletionsRequestProviderDataCollection"
        },
        {
          "type": "null"
        }
      ]
    },
    "zdr": {
      "description": "Whether to use zero data retention providers only.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "sort": {
      "description": "How to sort/prioritize providers.",
      "anyOf": [
        {
          "$ref": "AgentCompletionsRequestProviderSort"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_price": {
      "description": "Maximum price constraints.",
      "anyOf": [
        {
          "$ref": "AgentCompletionsRequestProviderMaxPrice"
        },
        {
          "type": "null"
        }
      ]
    },
    "preferred_min_throughput": {
      "description": "Preferred minimum throughput (tokens/second).",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "preferred_max_latency": {
      "description": "Preferred maximum latency (seconds).",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "min_throughput": {
      "description": "Hard minimum throughput requirement (tokens/second).",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "max_latency": {
      "description": "Hard maximum latency requirement (seconds).",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    }
  }
}
