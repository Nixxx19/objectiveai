{
  "type": "object",
  "properties": {
    "type": {
      "const": "image_url"
    },
    "image_url": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Either a URL of the image or the base64 encoded image data."
        },
        "detail": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "low",
                "high"
              ],
              "description": "Specifies the detail level of the image."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "url"
      ],
      "description": "The URL of the image and its optional detail level."
    }
  },
  "required": [
    "type",
    "image_url"
  ],
  "description": "An image rich content part."
}
