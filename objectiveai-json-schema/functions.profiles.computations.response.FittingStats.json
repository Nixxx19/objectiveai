{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functions.profiles.computations.response.FittingStats",
  "type": "object",
  "properties": {
    "loss": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$"
    },
    "executions": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "starts": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "rounds": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "loss",
    "executions",
    "starts",
    "rounds",
    "errors"
  ]
}
