{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FunctionsExpressionOneOrManystring",
  "description": "Result of an expression that may produce one or many values.",
  "anyOf": [
    {
      "description": "A single value.",
      "type": "string"
    },
    {
      "description": "Multiple values (from array expressions).",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  ]
}
