{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier of the vector completion."
    },
    "completions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier of the chat completion."
          },
          "upstream_id": {
            "type": "string",
            "description": "The unique identifier of the upstream chat completion."
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "delta": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string",
                      "description": "The content added in this delta."
                    },
                    "refusal": {
                      "type": "string",
                      "description": "The refusal message added in this delta."
                    },
                    "role": {
                      "enum": [
                        "assistant"
                      ],
                      "description": "The role of the message author."
                    },
                    "tool_calls": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "index": {
                                "type": "integer",
                                "description": "The index of the tool call in the sequence of tool calls."
                              },
                              "type": {
                                "const": "function"
                              },
                              "id": {
                                "type": "string",
                                "description": "The unique identifier of the function tool."
                              },
                              "function": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "description": "The name of the function."
                                  },
                                  "arguments": {
                                    "type": "string",
                                    "description": "The arguments passed to the function."
                                  }
                                }
                              }
                            },
                            "required": [
                              "index"
                            ],
                            "description": "A function tool call made by the assistant."
                          }
                        ],
                        "description": "A tool call made by the assistant."
                      },
                      "description": "Tool calls made in this delta."
                    },
                    "reasoning": {
                      "type": "string",
                      "description": "The reasoning added in this delta."
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "const": "image_url"
                              },
                              "image_url": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string",
                                    "description": "The Base64 URL of the generated image."
                                  }
                                },
                                "required": [
                                  "url"
                                ]
                              }
                            },
                            "required": [
                              "type",
                              "image_url"
                            ]
                          }
                        ],
                        "description": "An image generated by the model."
                      },
                      "description": "Images added in this delta."
                    }
                  },
                  "description": "A delta in a streaming chat completion response."
                },
                "finish_reason": {
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls",
                    "content_filter",
                    "error"
                  ],
                  "description": "The reason why the assistant ceased to generate further tokens."
                },
                "index": {
                  "type": "integer",
                  "description": "The index of the choice in the list of choices."
                },
                "logprobs": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "token": {
                                "type": "string",
                                "description": "The token string which was selected by the sampler."
                              },
                              "bytes": {
                                "anyOf": [
                                  {
                                    "type": "array",
                                    "items": {
                                      "type": "integer"
                                    }
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "The byte representation of the token which was selected by the sampler."
                              },
                              "logprob": {
                                "type": "number",
                                "description": "The log probability of the token which was selected by the sampler."
                              },
                              "top_logprobs": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "token": {
                                      "type": "string",
                                      "description": "The token string."
                                    },
                                    "bytes": {
                                      "anyOf": [
                                        {
                                          "type": "array",
                                          "items": {
                                            "type": "integer"
                                          }
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "The byte representation of the token."
                                    },
                                    "logprob": {
                                      "anyOf": [
                                        {
                                          "type": "number"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "The log probability of the token."
                                    }
                                  },
                                  "required": [
                                    "token"
                                  ],
                                  "description": "The log probability of a token in the list of top tokens."
                                },
                                "description": "The log probabilities of the top tokens for this position."
                              }
                            },
                            "required": [
                              "token",
                              "logprob",
                              "top_logprobs"
                            ],
                            "description": "The token which was selected by the sampler for this position as well as the logprobabilities of the top options."
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The log probabilities of the tokens in the content."
                    },
                    "refusal": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "token": {
                                "type": "string",
                                "description": "The token string which was selected by the sampler."
                              },
                              "bytes": {
                                "anyOf": [
                                  {
                                    "type": "array",
                                    "items": {
                                      "type": "integer"
                                    }
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "The byte representation of the token which was selected by the sampler."
                              },
                              "logprob": {
                                "type": "number",
                                "description": "The log probability of the token which was selected by the sampler."
                              },
                              "top_logprobs": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "token": {
                                      "type": "string",
                                      "description": "The token string."
                                    },
                                    "bytes": {
                                      "anyOf": [
                                        {
                                          "type": "array",
                                          "items": {
                                            "type": "integer"
                                          }
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "The byte representation of the token."
                                    },
                                    "logprob": {
                                      "anyOf": [
                                        {
                                          "type": "number"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "The log probability of the token."
                                    }
                                  },
                                  "required": [
                                    "token"
                                  ],
                                  "description": "The log probability of a token in the list of top tokens."
                                },
                                "description": "The log probabilities of the top tokens for this position."
                              }
                            },
                            "required": [
                              "token",
                              "logprob",
                              "top_logprobs"
                            ],
                            "description": "The token which was selected by the sampler for this position as well as the logprobabilities of the top options."
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The log probabilities of the tokens in the refusal."
                    }
                  },
                  "description": "The log probabilities of the tokens generated by the model."
                }
              },
              "required": [
                "delta",
                "index"
              ],
              "description": "A choice in a streaming chat completion response."
            },
            "description": "The list of choices in this chunk."
          },
          "created": {
            "type": "integer",
            "description": "The Unix timestamp (in seconds) when the chat completion was created."
          },
          "model": {
            "type": "string",
            "description": "The unique identifier of the Ensemble LLM used for this chat completion."
          },
          "upstream_model": {
            "type": "string",
            "description": "The upstream model used for this chat completion."
          },
          "object": {
            "const": "chat.completion.chunk"
          },
          "service_tier": {
            "type": "string"
          },
          "system_fingerprint": {
            "type": "string"
          },
          "usage": {
            "$ref": "ChatCompletionUsage",
            "description": "Token and cost usage statistics for the completion."
          },
          "upstream": {
            "$ref": "Upstream",
            "description": "The upstream provider that served the request."
          },
          "provider": {
            "type": "string",
            "description": "The provider used for this chat completion."
          },
          "index": {
            "type": "integer",
            "description": "The index of the completion amongst all chat completions."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "The status code of the error."
              },
              "message": {
                "$ref": "JsonValue",
                "description": "The message or details of the error."
              }
            },
            "required": [
              "code",
              "message"
            ],
            "description": "An error encountered during the generation of this chat completion."
          }
        },
        "required": [
          "id",
          "upstream_id",
          "choices",
          "created",
          "model",
          "upstream_model",
          "object",
          "upstream",
          "index"
        ],
        "description": "A chat completion chunk generated in the pursuit of a vector completion."
      },
      "description": "The list of chat completion chunks created for this vector completion."
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "The unique identifier of the Ensemble LLM which generated this vote."
          },
          "ensemble_index": {
            "type": "integer",
            "description": "The index of the Ensemble LLM in the Ensemble."
          },
          "flat_ensemble_index": {
            "type": "integer",
            "description": "The flat index of the Ensemble LLM in the expanded Ensemble, accounting for counts."
          },
          "vote": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "The vote generated by this Ensemble LLM. It is of the same length of the number of responses provided in the request. If the Ensemble LLM used logprobs, may be a probability distribution; otherwise, one of the responses will have a value of 1 and the rest 0."
          },
          "weight": {
            "type": "number",
            "description": "The weight assigned to this vote."
          },
          "retry": {
            "type": "boolean",
            "description": "Whether this vote came from a previous Vector Completion which was retried. `from_cache` will also be `true`."
          },
          "from_cache": {
            "type": "boolean",
            "description": "Whether this vote came from the global ObjectiveAI votes cache."
          },
          "from_rng": {
            "type": "boolean",
            "description": "Whether this vote was generated via RNG."
          }
        },
        "required": [
          "model",
          "ensemble_index",
          "flat_ensemble_index",
          "vote",
          "weight"
        ],
        "description": "A vote from an Ensemble LLM within a Vector Completion."
      },
      "description": "The list of votes for responses in the request from the Ensemble LLMs within the provided Ensemble."
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "The scores for each response in the request, aggregated from the votes of the Ensemble LLMs."
    },
    "weights": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "The weights assigned to each response in the request, aggregated from the votes of the Ensemble LLMs."
    },
    "created": {
      "type": "integer",
      "description": "The Unix timestamp (in seconds) when the vector completion was created."
    },
    "ensemble": {
      "type": "string",
      "description": "The unique identifier of the Ensemble used for this vector completion."
    },
    "object": {
      "const": "vector.completion.chunk"
    },
    "usage": {
      "$ref": "VectorCompletionUsage",
      "description": "Token and cost usage statistics for the completion."
    },
    "index": {
      "type": "integer",
      "description": "The index of the task in the sequence of tasks."
    },
    "task_index": {
      "type": "integer",
      "description": "The index of the task amongst all mapped and non-skipped compiled tasks. Used internally."
    },
    "task_path": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "The path of this task which may be used to navigate which nested task this is amongst the root functions tasks and sub-tasks."
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "description": "The status code of the error."
        },
        "message": {
          "$ref": "JsonValue",
          "description": "The message or details of the error."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "description": "When present, indicates that an error occurred during the vector completion task."
    }
  },
  "required": [
    "id",
    "completions",
    "votes",
    "scores",
    "weights",
    "created",
    "ensemble",
    "object",
    "index",
    "task_index",
    "task_path"
  ],
  "description": "A chunk of a vector completion task."
}
