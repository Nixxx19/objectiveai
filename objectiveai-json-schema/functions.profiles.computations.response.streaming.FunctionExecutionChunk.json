{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functions.profiles.computations.response.streaming.FunctionExecutionChunk",
  "type": "object",
  "properties": {
    "index": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "dataset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "n": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "retry": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "id": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "functions.executions.response.streaming.TaskChunk"
      }
    },
    "tasks_errors": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "functions.executions.response.streaming.ReasoningSummaryChunk"
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "anyOf": [
        {
          "$ref": "functions.expression.TaskOutputOwned"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "ResponseError"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "function": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "object": {
      "$ref": "functions.executions.response.streaming.Object"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "agent.completions.response.Usage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "index",
    "dataset",
    "n",
    "retry",
    "id",
    "tasks",
    "created",
    "object"
  ]
}
