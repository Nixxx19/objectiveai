{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletionsMessageAssistantToolCall",
  "description": "A tool call made by the assistant.",
  "oneOf": [
    {
      "description": "A function call with an ID and function details.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The unique ID of this tool call.",
          "type": "string"
        },
        "function": {
          "description": "The function being called.",
          "$ref": "AgentCompletionsMessageAssistantToolCallFunction"
        },
        "type": {
          "type": "string",
          "const": "function"
        }
      },
      "required": [
        "type",
        "id",
        "function"
      ]
    }
  ]
}
