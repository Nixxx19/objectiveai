{
  "title": "agent.openrouter.AgentBase",
  "description": "The base configuration for an OpenRouter Agent (without computed ID).",
  "type": "object",
  "properties": {
    "frequency_penalty": {
      "description": "Penalizes tokens based on their frequency in the output so far (-2.0 to 2.0).",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "null"
        }
      ]
    },
    "logit_bias": {
      "description": "Token ID to bias mapping (-100 to 100). Positive values increase likelihood.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "max_completion_tokens": {
      "description": "Maximum tokens in the completion.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "null"
        }
      ]
    },
    "max_tokens": {
      "description": "Maximum tokens (OpenRouter variant of max_completion_tokens).",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "null"
        }
      ]
    },
    "mcp_servers": {
      "description": "MCP servers the agent can connect to.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "agent.McpServer"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "min_p": {
      "description": "Minimum probability threshold for sampling (0.0 to 1.0).",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "description": "The upstream language model identifier (e.g., `\"gpt-4\"`, `\"claude-3-opus\"`).",
      "type": "string"
    },
    "output_mode": {
      "description": "The output mode for vector completions. Ignored for agent completions.",
      "$ref": "agent.openrouter.OutputMode",
      "default": "instruction"
    },
    "post_system_prefix_messages": {
      "description": "Messages inserted after the leading chain of system/developer messages.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "agent.completions.message.Message"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "prefix_messages": {
      "description": "Messages prepended to the user's prompt.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "agent.completions.message.Message"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "presence_penalty": {
      "description": "Penalizes tokens based on their presence in the output so far (-2.0 to 2.0).",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "description": "Provider routing preferences.",
      "anyOf": [
        {
          "$ref": "agent.openrouter.Provider"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning": {
      "description": "Reasoning/thinking configuration for supported models.",
      "anyOf": [
        {
          "$ref": "agent.openrouter.Reasoning"
        },
        {
          "type": "null"
        }
      ]
    },
    "repetition_penalty": {
      "description": "Repetition penalty (0.0 to 2.0). Values > 1.0 penalize repetition.",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "null"
        }
      ]
    },
    "stop": {
      "description": "Stop sequences that halt generation.",
      "anyOf": [
        {
          "$ref": "agent.openrouter.Stop"
        },
        {
          "type": "null"
        }
      ]
    },
    "suffix_messages": {
      "description": "Messages appended after the user's prompt.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "agent.completions.message.Message"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "synthetic_reasoning": {
      "description": "Enable synthetic reasoning for non-reasoning LLMs.\n\n**Vector completions only.** Ignored for agent completions.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "temperature": {
      "description": "Sampling temperature (0.0 to 2.0). Higher = more random.",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "null"
        }
      ]
    },
    "top_a": {
      "description": "Top-a sampling parameter (0.0 to 1.0).",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "null"
        }
      ]
    },
    "top_k": {
      "description": "Top-k sampling: only consider the k most likely tokens.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "null"
        }
      ]
    },
    "top_logprobs": {
      "description": "Number of top log probabilities to return (2-20).\n\n**Vector completions only.** Ignored for agent completions.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "null"
        }
      ]
    },
    "top_p": {
      "description": "Nucleus sampling probability (0.0 to 1.0).",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "null"
        }
      ]
    },
    "upstream": {
      "description": "The upstream provider marker.",
      "$ref": "agent.openrouter.Upstream"
    },
    "verbosity": {
      "description": "Output verbosity hint for supported models.",
      "anyOf": [
        {
          "$ref": "agent.openrouter.Verbosity"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
