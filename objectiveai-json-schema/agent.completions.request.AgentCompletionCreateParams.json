{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent.completions.request.AgentCompletionCreateParams",
  "description": "Parameters for creating a agent completion.",
  "type": "object",
  "properties": {
    "messages": {
      "description": "The conversation messages.",
      "type": "array",
      "items": {
        "$ref": "agent.completions.message.Message"
      }
    },
    "provider": {
      "description": "Provider routing preferences.",
      "anyOf": [
        {
          "$ref": "agent.completions.request.Provider"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent": {
      "description": "The agent to use (inline Agent or stored ID).",
      "$ref": "agent.completions.request.Agent"
    },
    "agents": {
      "description": "Alternative agents to try if the primary agent fails.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "agent.completions.request.Agent"
      }
    },
    "response_format": {
      "description": "Output format constraints (text, JSON, or JSON schema).",
      "anyOf": [
        {
          "$ref": "agent.completions.request.ResponseFormatParam"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "description": "Random seed for deterministic generation.",
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "stream": {
      "description": "Whether to stream the response.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "mcp_server_authorization": {
      "description": "Map from MCP server URL to authorization header value.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "messages",
    "agent"
  ]
}
