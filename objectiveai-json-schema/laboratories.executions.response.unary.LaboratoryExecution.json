{
  "title": "laboratories.executions.response.unary.LaboratoryExecution",
  "description": "A complete laboratory execution response (non-streaming).",
  "type": "object",
  "properties": {
    "builders": {
      "description": "Results from each builder agent completion.",
      "type": "array",
      "items": {
        "$ref": "laboratories.executions.response.unary.Builder"
      }
    },
    "created": {
      "description": "Unix timestamp when the execution was created.",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "error": {
      "description": "Error details if the execution failed.",
      "anyOf": [
        {
          "$ref": "error.ResponseError"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluations": {
      "description": "Results from each evaluation agent completion.",
      "type": "array",
      "items": {
        "$ref": "laboratories.executions.response.unary.Evaluation"
      }
    },
    "id": {
      "description": "Unique identifier for this execution.",
      "type": "string"
    },
    "object": {
      "description": "Object type identifier.",
      "$ref": "laboratories.executions.response.unary.Object"
    },
    "usage": {
      "description": "Aggregated token and cost usage.",
      "$ref": "agent.completions.response.Usage"
    }
  }
}
