        },
        "type": {
          "type": "string",
          "enum": [
            "alpha.scalar.function"
          ]
        }
      }
    },
    {
      "title": "VectorFunctionInputSchema",
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "functions.alpha_vector.expression.VectorFunctionInputSchema"
        },
        "type": {
          "type": "string",
          "enum": [
            "alpha.vector.function"
          ]
        }
      }
    }
  ]
}
