{
  "type": "alpha.vector.branch.function",
  "description": "Vector super branch with three vector branch sub-functions including context.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": ["text"]
    },
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "mock-12",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "mock-13",
      "input": {
        "context": {
          "$starlark": "{'query': input['context']['text']}"
        },
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "mock-16",
      "input": {
        "context": {
          "$starlark": "{'text': input['context']['text']}"
        },
        "items": {
          "$starlark": "input['items']"
        }
      }
    }
  ]
}
