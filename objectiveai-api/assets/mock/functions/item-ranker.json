{
  "type": "alpha.vector.leaf.function",
  "description": "Ranks a list of items by overall preference.",
  "input_schema": {
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Rank these items.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    }
  ]
}
