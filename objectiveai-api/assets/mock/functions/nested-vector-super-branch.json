{
  "type": "alpha.vector.branch.function",
  "description": "Two-level nested item ranking combining the dual-ranker and triple-ranker branches.",
  "input_schema": {
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "dual-ranker-branch",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "triple-ranker-branch",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    }
  ]
}
