    },\n        {\n          \"title\": \"Value\",\n          \"description\": \"A literal value.\",\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        }\n      ]\n    }\n  }\n}\n",
