{
  "type": "alpha.vector.branch.function",
  "description": "Vector branch mixing scalar and vector sub-functions.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": ["query"]
    },
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "owner": "mock",
      "repository": "mock-1",
      "commit": "mock",
      "input": {
        "$starlark": "{'text': input['context']['query']}"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "owner": "mock",
      "repository": "mock-6",
      "commit": "mock",
      "input": {
        "$starlark": "{'subject': input['context']['query'], 'body': input['context']['query']}"
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "owner": "mock",
      "repository": "mock-4",
      "commit": "mock",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    }
  ]
}
