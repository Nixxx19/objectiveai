{
  "type": "alpha.vector.leaf.function",
  "description": "Vector ranker with 5 diverse scoring criteria.",
  "input_schema": {
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Rank by overall quality.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    },
