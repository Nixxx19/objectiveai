{
  "type": "alpha.scalar.leaf.function",
  "description": "Scalar with many responses (5-way classification).",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": ["text"]
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Rate: ' + input['text']}]}]"
      },
      "responses": [
        [{"type": "text", "text": "1 star"}],
        [{"type": "text", "text": "2 stars"}],
        [{"type": "text", "text": "3 stars"}],
        [{"type": "text", "text": "4 stars"}],
        [{"type": "text", "text": "5 stars"}]
      ]
    }
  ]
}
