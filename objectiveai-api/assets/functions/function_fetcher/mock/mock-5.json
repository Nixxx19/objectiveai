{
  "type": "alpha.vector.leaf.function",
  "description": "Vector ranker with context and multiple tasks.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": ["query"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    }
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Query: ' + input['context']['query'] + '. Rank by relevance.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    },
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Query: ' + input['context']['query'] + '. Rank by quality.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    }
  ]
}
