{
  "type": "alpha.scalar.leaf.function",
  "description": "Simple binary classifier with one vector completion task.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Text to classify"
      }
    },
    "required": ["text"]
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': input['text']}]}]"
      },
      "responses": [
        [{"type": "text", "text": "Yes"}],
        [{"type": "text", "text": "No"}]
      ]
    }
  ]
}
